@using System.Reflection
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject JwtAuthenticationStateProvider AuthStateProvider

@if (!_initialized)
{
    <p>Проверка авторизации...</p>
}
else if (_showNotAuthorized)
{
    <LayoutView Layout="typeof(Layout.MainLayout)">
        <h1>JWT Auth Demo</h1>
        <p>JwtAuthorizeRouteView · <strong>NotAuthorized</strong> — для доступа нужно войти.</p>
        <LoginPanel />
    </LayoutView>
}
else
{
    <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    [Parameter]
    public Type? DefaultLayout { get; set; }

    private bool _initialized;
    private bool _showNotAuthorized;
    private AuthenticationState _authState = new(new ClaimsPrincipal(new ClaimsIdentity()));

    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthStateProvider.InitializeFromStorageAsync();
        _authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        UpdateShowNotAuthorized();
        _initialized = true;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (_initialized)
            UpdateShowNotAuthorized();
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _authState = await task;
        UpdateShowNotAuthorized();
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateShowNotAuthorized()
    {
        var requiresAuth = RouteData.PageType.GetCustomAttribute<RequireAuthAttribute>() is not null;
        var isAuthenticated = _authState.User.Identity?.IsAuthenticated == true;
        _showNotAuthorized = requiresAuth && !isAuthenticated;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
